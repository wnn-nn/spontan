# ==========================================
# Root .gitignore untuk Proyek Spontan
# ==========================================

# Environment variables & secrets (PENTING: Jangan push kredensial/password)
.env
*.env
!.env.example
backend/.env

# Node.js / Backend
node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Flutter / Mobile
.dart_tool/
mobile/.dart_tool/
.flutter-plugins
mobile/.flutter-plugins
.flutter-plugins-dependencies
mobile/.flutter-plugins-dependencies
.pub-cache/
mobile/.pub-cache/
.pub/
mobile/.pub/
build/
mobile/build/
coverage/
mobile/coverage/

# Android Studio, VS Code, and JetBrains IDEs
.idea/
mobile/.idea/
*.iml
mobile/*.iml
*.ipr
*.iws
.vscode/

# OS Generated Files
.DS_Store
Thumbs.db
desktop.ini
*.log
